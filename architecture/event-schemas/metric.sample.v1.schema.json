{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cloudpulse.local/schemas/metric.sample.v1.json",
  "title": "metric.sample v1",
  "type": "object",
  "required": [
    "eventId",
    "eventType",
    "eventVersion",
    "occurredAt",
    "correlationId",
    "source",
    "data"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "eventType": {
      "const": "metric.sample"
    },
    "eventVersion": {
      "const": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "correlationId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,64}$"
    },
    "source": {
      "const": "operations-service"
    },
    "data": {
      "type": "object",
      "required": [
        "service",
        "metric",
        "value",
        "synthetic"
      ],
      "properties": {
        "service": {
          "type": "string",
          "minLength": 1
        },
        "metric": {
          "enum": [
            "request_count",
            "latency_ms",
            "cpu_pct",
            "memory_pct",
            "pod_restarts",
            "db_connections_pct",
            "error_rate_pct",
            "event_latency_ms",
            "business_transactions"
          ]
        },
        "value": {
          "type": "number"
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "synthetic": {
          "type": "boolean"
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  },
  "additionalProperties": true
}
