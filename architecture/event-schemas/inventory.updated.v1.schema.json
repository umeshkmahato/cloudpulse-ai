{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cloudpulse.local/schemas/inventory.updated.v1.json",
  "title": "inventory.updated v1",
  "type": "object",
  "required": [
    "eventId",
    "eventType",
    "eventVersion",
    "occurredAt",
    "correlationId",
    "source",
    "data"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "eventType": {
      "const": "inventory.updated"
    },
    "eventVersion": {
      "const": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "correlationId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,64}$"
    },
    "source": {
      "const": "inventory-service"
    },
    "data": {
      "type": "object",
      "required": [
        "orderId",
        "status",
        "items"
      ],
      "properties": {
        "orderId": {
          "type": "string"
        },
        "status": {
          "enum": [
            "RESERVED",
            "REJECTED"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "sku",
              "quantity",
              "remainingAvailable"
            ],
            "properties": {
              "sku": {
                "type": "string"
              },
              "quantity": {
                "type": "integer",
                "minimum": 1
              },
              "remainingAvailable": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    }
  },
  "additionalProperties": true
}
