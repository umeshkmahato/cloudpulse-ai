{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cloudpulse.local/schemas/order.created.v1.json",
  "title": "order.created v1",
  "type": "object",
  "required": [
    "eventId",
    "eventType",
    "eventVersion",
    "occurredAt",
    "correlationId",
    "source",
    "data"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "eventType": {
      "const": "order.created"
    },
    "eventVersion": {
      "const": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "correlationId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,64}$"
    },
    "source": {
      "const": "order-service"
    },
    "data": {
      "type": "object",
      "required": [
        "orderId",
        "customerId",
        "items",
        "totalAmount",
        "currency"
      ],
      "properties": {
        "orderId": {
          "type": "string",
          "pattern": "^ORD-[A-Z0-9]{12}$"
        },
        "customerId": {
          "type": "string",
          "minLength": 1
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "sku",
              "quantity",
              "unitPrice"
            ],
            "properties": {
              "sku": {
                "type": "string"
              },
              "quantity": {
                "type": "integer",
                "minimum": 1
              },
              "unitPrice": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          }
        },
        "totalAmount": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        }
      }
    }
  },
  "additionalProperties": true
}
